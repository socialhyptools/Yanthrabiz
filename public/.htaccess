# Yantra Biz — Hostinger static hosting config
# Place this file at the document root (public_html/) alongside the built `out/` files.

# ----- Force HTTPS -----
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ----- Strip www (canonical: non-www). Comment this block if the canonical host should be www. -----
# RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]

# ----- 301 Redirects: Old URLs → New URLs (permanent SEO-safe redirects) -----
# These fire before the pretty-URL rule so they always match correctly.

# Agriculture Machinery
RewriteRule ^industries/agriculture-machinery/?$ /industries/agriculture-machinery-and-equipment/ [R=301,L]

# Food & Beverage Processing
RewriteRule ^industries/beverage-food-processing/?$ /industries/food-processing-machine/ [R=301,L]

# Leather Processing
RewriteRule ^industries/leather-processing/?$ /industries/leather-processing-machinery/ [R=301,L]

# Material Handling
RewriteRule ^industries/material-handling/?$ /industries/material-handling-machine/ [R=301,L]

# Plastic Machinery
RewriteRule ^industries/plastic-machinery/?$ /industries/plastic-industrial-machinery/ [R=301,L]

# Chemical Machinery (moved from /industries/ to root level)
RewriteRule ^industries/chemical-machinery/?$ /chemical-machinery/ [R=301,L]

# ----- Pretty URLs: serve /path as /path/index.html (Next.js trailingSlash export) -----
RewriteRule ^([^.]+[^/])$ /$1/ [R=301,L]

# ----- Custom 404 -----
ErrorDocument 404 /404.html

# ----- Compression -----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# ----- Cache static assets aggressively -----
<IfModule mod_expires.c>
  ExpiresActive On
  # HTML: short cache
  ExpiresByType text/html "access plus 1 hour"
  # CSS, JS: long cache (filenames are hashed)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  # Images & fonts
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

# ----- Security headers -----
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" env=HTTPS
</IfModule>

# ----- Block access to sensitive files -----
<FilesMatch "^\.(?!well-known)">
  Require all denied
</FilesMatch>
